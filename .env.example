# Session cookie encryption (min 32 chars) — usado só no modo local
SESSION_SECRET=prooftaker-local-dev-session-secret-32b

# ── Lovable Cloud / Supabase ─────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Obrigatório em produção (coleta pública, upload, admin)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=ProofTaker <ola@seudominio.com.br>

# Optional: Stripe Checkout
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_PRO=price_xxx
# Local: stripe listen --forward-to localhost:8080/api/stripe/webhook
# Prod: Dashboard → Webhooks → endpoint /api/stripe/webhook → signing secret
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: IA (melhoria de depoimentos + templates de pedido)
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
